# Response headers for highdesertdevelopment.com.
# Cloudflare's Workers static assets reads this file and does not serve it.
# Defaults are public, max-age=0, must-revalidate on everything, so every
# visit was refetching the stylesheet, the script and every photograph.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'self'

# main.css and main.js carry a ?v= version query, and the cache key includes
# it, so a year is safe: a new version is a new URL and lands immediately.
/styles/*
  Cache-Control: public, max-age=31536000, immutable

/scripts/*
  Cache-Control: public, max-age=31536000, immutable

# Photographs have no version in their filenames, so they get a long cache but
# never immutable. Replacing one in place has to be able to take effect, which
# is exactly what caught the link preview card in August.
/images/*
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=2592000

/favicon-32.png
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
